<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fer_hand_mjc</name>
  <version>0.0.0</version>
  <description>The MuJoCo simulation: a scripted human hand (a sphere) and ROS-commanded bodies (the tracker cube); publishes their positions on ROS 2 and shows them in MuJoCo and RViz.</description>
  <maintainer email="jacobtom99rp@gmail.com">Tom Jacob</maintainer>
  <license>Apache-2.0</license>

  <!-- MuJoCo Python bindings: pip mujoco==3.4.0, installed by docker/Dockerfile (no rosdep key). -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>tf2_ros_py</depend>
  <depend>ament_index_python</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
