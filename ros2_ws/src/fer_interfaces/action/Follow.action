# Follow.action
# Keeps the TCP (fer_hand_tcp) at `offset` relative to a moving TF frame until the goal is
# cancelled. The target is read from TF again in every control cycle.

string target_frame                 # TF frame to follow, e.g. "hand"
geometry_msgs/Pose offset           # TCP pose in target_frame; identity: TCP at the frame origin
bool follow_orientation false       # false: TCP orientation stays as at goal start
float64 speed_scaling 1.0           # (0, 1]; scales the backend's follow speed cap. Lower values
                                    # can leave the TCP behind a moving hand.
float64 target_timeout 0.5          # s; target older than this: the arm stops, NOT_FOUND
---
Outcome outcome                     # CANCELLED (the normal end), INVALID_GOAL, UNSUPPORTED,
                                    # NOT_FOUND, UNREACHABLE (arm halted or stalled, e.g.
                                    # singularity),
                                    # EXECUTION_FAILED, ROBOT_ERROR
---
float32 distance                    # m, TCP position to its target position
